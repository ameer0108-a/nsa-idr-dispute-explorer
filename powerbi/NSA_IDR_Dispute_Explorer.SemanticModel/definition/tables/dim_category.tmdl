table dim_category
	lineageTag: e635cdcd-e691-5f6a-bb3b-6cae9f8e3342

	column dispute_category
		dataType: string
		lineageTag: 9da60776-cffb-5a21-bd5d-8b1703fa8234
		summarizeBy: none
		sourceColumn: dispute_category
		sortByColumn: category_sort

		annotation SummarizationSetBy = User

	column category_sort
		dataType: int64
		isHidden
		lineageTag: 29c40a41-bba2-5cbe-a20f-0d83894d2e21
		summarizeBy: none
		sourceColumn: category_sort

		annotation SummarizationSetBy = User

	partition dim_category = m
		mode: import
		source =
				let
				    Source = v_quarterly_summary,
				    Kept = Table.Distinct(Table.SelectColumns(Source, {"dispute_category"})),
				    Sorted = Table.AddColumn(Kept, "category_sort", each if [dispute_category] = "All dispute types" then 1 else if [dispute_category] = "Emergency / non-emergency" then 2 else 3, Int64.Type)
				in
				    Sorted

	annotation PBI_ResultType = Table

