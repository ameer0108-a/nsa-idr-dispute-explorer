	partition v_quarterly_summary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportsFolder & "v_quarterly_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
