				    Typed = Table.TransformColumnTypes(Blanks, {{"period", type text}, {"period_type", type text}, {"period_sort", Int64.Type}, {"dispute_category", type text}, {"line_items", Int64.Type}, {"disputes", Int64.Type}, {"provider_wins", Int64.Type}, {"plan_wins", Int64.Type}, {"split_decisions", Int64.Type}, {"provider_win_rate", type number}, {"default_decisions", Int64.Type}, {"default_decision_rate", type number}, {"batched_disputes", Int64.Type}, {"batched_share", type number}, {"median_business_days", type number}, {"idre_compensation_total", type number}, {"lines_with_qpa_ratio", Int64.Type}, {"lines_provider_selected", Int64.Type}, {"line_provider_selected_rate", type number}, {"median_prevailing_offer_qpa_ratio", type number}, {"median_provider_offer_qpa_ratio", type number}, {"median_plan_offer_qpa_ratio", type number}, {"share_prevailing_above_qpa", type number}}, "en-US")
