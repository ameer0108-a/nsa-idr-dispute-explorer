	measure 'Ineligible Share' =
			CALCULATE(
			    DIVIDE(SUM(v_eligibility_trend[found_ineligible]), SUM(v_eligibility_trend[total_closed])),
			    v_eligibility_trend[dispute_category] = "All dispute types"
			)
		formatString: 0.0%
		displayFolder: Eligibility
		lineageTag: 4705eb32-abd1-53fa-bd7a-171c22a5bfd7

	measure 'Closed: Payment Determination' = CALCULATE(SUM(v_eligibility_trend[payment_determinations]), v_eligibility_trend[dispute_category] = "All dispute types")
		formatString: #,0
		displayFolder: Eligibility
		lineageTag: 84460507-859f-5e59-9ff7-41e11b5fb6f4

	measure 'Closed: Found Ineligible' = CALCULATE(SUM(v_eligibility_trend[found_ineligible]), v_eligibility_trend[dispute_category] = "All dispute types")
		formatString: #,0
		displayFolder: Eligibility
		lineageTag: e4a10912-9751-5e52-b549-0b488e8f7c1c

	measure 'Closed: Other Reason' = CALCULATE(SUM(v_eligibility_trend[other_closed]), v_eligibility_trend[dispute_category] = "All dispute types")
		formatString: #,0
		displayFolder: Eligibility
		lineageTag: caf7b089-e119-5e2f-bfd4-3b9f1cfc6414

	measure 'Ineligible Share, Apr to Sep 2022' =
			CALCULATE(
			    DIVIDE(SUM(v_eligibility_trend[found_ineligible]), SUM(v_eligibility_trend[total_closed])),
			    v_eligibility_trend[dispute_category] = "All dispute types",
			    v_eligibility_trend[year] = 2022,
			    v_eligibility_trend[quarter] IN {2, 3}
			)
		formatString: 0%
		displayFolder: Eligibility
		lineageTag: ff802ae8-8629-5dd8-97ce-59b6dbb084e0

	measure 'Ineligible Share, 2025' =
			CALCULATE(
			    DIVIDE(SUM(v_eligibility_trend[found_ineligible]), SUM(v_eligibility_trend[total_closed])),
			    v_eligibility_trend[dispute_category] = "All dispute types",
			    v_eligibility_trend[year] = 2025
