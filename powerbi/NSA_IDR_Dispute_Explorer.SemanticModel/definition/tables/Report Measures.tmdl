	measure 'State Disputes (Top 15)' =
			VAR p = [Selected Period]
			VAR c = [Selected Category]
			RETURN
			    VAR r =
			        CALCULATE(
			            MIN(v_outcomes_by_state[state_rank]),
			            v_outcomes_by_state[period] = p,
			            v_outcomes_by_state[dispute_category] = c
			        )
			    RETURN
			        IF(
			            NOT ISBLANK(r) && r <= 15,
			            CALCULATE(
			                SUM(v_outcomes_by_state[disputes]),
			                v_outcomes_by_state[period] = p,
			                v_outcomes_by_state[dispute_category] = c
			            )
			        )
		formatString: #,0
		displayFolder: States
		lineageTag: acf6952f-8238-5a58-bd11-6b7ebc2a5d10

