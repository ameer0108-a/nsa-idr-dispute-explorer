		lineageTag: c45027fd-2cbe-5253-bc5c-1d262f6f655e

	measure 'CMS Published Determinations' =
			CALCULATE(
			    SUM(v_reconciliation[cms_published]),
			    v_reconciliation[metric_sort] = 1,
			    v_reconciliation[dispute_category] = "All dispute types"
			)
		formatString: #,0
		displayFolder: Reconciliation
		lineageTag: 90d40293-36d1-5949-883d-9d27fe70b926

	measure 'PUF Disputes (Raw)' =
			CALCULATE(
			    SUM(v_reconciliation[puf_raw]),
			    v_reconciliation[metric_sort] = 1,
			    v_reconciliation[dispute_category] = "All dispute types"
			)
		formatString: #,0
		displayFolder: Reconciliation
		lineageTag: 961a4a80-2478-5d4e-bd43-0e63ca61b2d2

	measure 'PUF minus CMS' = [PUF Disputes (Raw)] - [CMS Published Determinations]
		formatString: #,0
		displayFolder: Reconciliation
		lineageTag: 5a904863-d49f-5f89-ad34-58ffe35843b2

	measure 'PUF vs CMS Difference %' = DIVIDE([PUF Disputes (Raw)] - [CMS Published Determinations], [CMS Published Determinations])
		formatString: 0.000%
		displayFolder: Reconciliation
		lineageTag: 08b9dec9-3932-5584-add6-966bd87a32a6

	measure 'Largest Quarterly Gap vs CMS' =
			MAXX(
			    FILTER(
			        ALL(v_reconciliation),
			        v_reconciliation[metric_sort] = 1 && v_reconciliation[period_type] = "Quarter"
			    ),
			    ABS(v_reconciliation[raw_pct_difference])
			)
		formatString: 0.000%
		displayFolder: Reconciliation
		lineageTag: feedd4f5-41b2-5188-896f-46f52d2e28fd

	measure 'DQ Rows Flagged' =
			IF(
			    NOT (SELECTEDVALUE(v_dq_summary[check_id]) IN {"ALL", "REJ"}),
			    SUM(v_dq_summary[rows_flagged])
			)
		formatString: #,0
		displayFolder: Data quality
		lineageTag: c5707e39-2126-5d85-9133-e27c1c969b8c

	measure 'DQ Share of Rows' =
			IF(
			    NOT (SELECTEDVALUE(v_dq_summary[check_id]) IN {"ALL", "REJ"}),
			    SUM(v_dq_summary[share_of_rows])
			)
		formatString: 0.000%
		displayFolder: Data quality
		lineageTag: fcad2d48-ffdc-5300-ad50-7741f30303b4

	measure 'Rows Failing Any Check' = CALCULATE(SUM(v_dq_summary[share_of_rows]), v_dq_summary[check_id] = "ALL")
		formatString: 0.00%
		displayFolder: Data quality
		lineageTag: 4fa3b177-7abb-55b2-85b0-ae5226067a67

	measure 'Rows Rejected' = CALCULATE(SUM(v_dq_summary[share_of_rows]), v_dq_summary[check_id] = "REJ")
		formatString: 0.00%
		displayFolder: Data quality
		lineageTag: 3982dfe5-c080-502b-925d-3a06b0c64fcd

	measure 'Line Items Checked' = MAX(v_dq_summary[total_rows])
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 3cc2b67e-3820-5f7d-9e5a-ca8e33d91251

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 1b4f799f-72db-5e5c-ae07-f53a59c8d9f8
		summarizeBy: none
		sourceColumn: Placeholder

		annotation SummarizationSetBy = User

	partition 'Report Measures' = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source

	annotation PBI_ResultType = Table

