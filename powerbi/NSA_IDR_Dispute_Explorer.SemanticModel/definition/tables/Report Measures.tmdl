table 'Report Measures'
	lineageTag: b02d47b1-2b03-5952-87ed-8aca52833ede

	measure 'Selected Period' =
			VAR latestFullYear =
			    CALCULATE(
			        MAX(dim_period[period]),
			        REMOVEFILTERS(dim_period),
			        dim_period[period_type] = "Full year"
			    )
			RETURN
			    SELECTEDVALUE(dim_period[period], latestFullYear)
		displayFolder: Selection
		lineageTag: 546182b6-30e6-5b68-b6b3-a548ffa83440

	measure 'Selected Category' = SELECTEDVALUE(dim_category[dispute_category], "All dispute types")
		displayFolder: Selection
		lineageTag: 68238a2b-6843-5499-b6ef-a6f88b8e6114

	measure 'Selection Label' = [Selected Period] & "  |  " & [Selected Category]
		displayFolder: Selection
		lineageTag: 7cb473b6-cf70-572b-9712-44169d1fe8fc

	measure 'Disputes Decided' =
			VAR p = [Selected Period]
			VAR c = [Selected Category]
			RETURN
			    CALCULATE(
			        SUM(v_quarterly_summary[disputes]),
			        v_quarterly_summary[period] = p,
			        v_quarterly_summary[dispute_category] = c
			    )
		formatString: #,0
		displayFolder: Overview
		lineageTag: 582fc842-eab5-576f-9ad1-21219a3fa2cb

	measure 'Line Items' =
			VAR p = [Selected Period]
			VAR c = [Selected Category]
			RETURN
			    CALCULATE(
			        SUM(v_quarterly_summary[line_items]),
			        v_quarterly_summary[period] = p,
			        v_quarterly_summary[dispute_category] = c
			    )
		formatString: #,0
		displayFolder: Overview
		lineageTag: 8a8a081e-f4be-591e-95d2-6ed692e47186

	measure 'Provider Win Rate' =
			DIVIDE(
			VAR p = [Selected Period]
			VAR c = [Selected Category]
			RETURN
			    CALCULATE(
			        SUM(v_quarterly_summary[provider_wins]),
			        v_quarterly_summary[period] = p,
			        v_quarterly_summary[dispute_category] = c
			    ),
			    [Disputes Decided]
			)
		formatString: 0.0%
		displayFolder: Overview
		lineageTag: 6a548dec-032d-5e08-b55d-8e9743db3021

	measure 'Default Decision Rate' =
			DIVIDE(
			VAR p = [Selected Period]
			VAR c = [Selected Category]
			RETURN
			    CALCULATE(
			        SUM(v_quarterly_summary[default_decisions]),
			        v_quarterly_summary[period] = p,
			        v_quarterly_summary[dispute_category] = c
			    ),
			    [Disputes Decided]
			)
		formatString: 0.0%
		displayFolder: Overview
		lineageTag: 79fa3375-7dc3-52e2-83c0-9a612917b30c

