		formatString: 0.0%
		displayFolder: Eligibility
		lineageTag: c7d6501e-9b92-5bf0-80ba-b67e51366517

	measure 'Closed Disputes in Line-Item Files, 2025' =
			CALCULATE(
			    DIVIDE(SUM(v_eligibility_trend[payment_determinations]), SUM(v_eligibility_trend[total_closed])),
			    v_eligibility_trend[dispute_category] = "All dispute types",
