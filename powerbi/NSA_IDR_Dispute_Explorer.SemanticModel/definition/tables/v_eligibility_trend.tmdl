	partition v_eligibility_trend = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportsFolder & "v_eligibility_trend.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"period", type text}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"period_sort", Int64.Type}, {"dispute_category", type text}, {"disputes_initiated", Int64.Type}, {"total_closed", Int64.Type}, {"payment_determinations", Int64.Type}, {"found_ineligible", Int64.Type}, {"other_closed", Int64.Type}, {"ineligible_share", type number}, {"determination_share", type number}, {"other_share", type number}, {"source", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

